deployment:
  image:
    repository: mendhak/http-https-echo:42
  env:
    HTTP_PORT:
      value: "3000"
    # HTTPS_PORT:
    #   value: '3443'
  ports:
    - name: http
      containerPort: 3000
      protocol: TCP
  automountServiceAccountToken: true
service:
  type: ClusterIP
  ports:
    - name: http
      port: 80
      appProtocol: http
      targetPort: http
rbac:
  enabled: true
  serviceAccount:
    create: true
    # name: "{{`{{ .Release.Name }}`}}"
# TODO:
# serviceMonitor:
extraObjects:
  # ns:
  #   apiVersion: v1
  #   kind: Namespace
  #   metadata:
  #     name: "{{`{{ .Release.Namespace }}`}}"
  #     annotations:
  #       helm.sh/hook: pre-install,pre-upgrade
  #       helm.sh/hook-weight: "-5"
  #       helm.sh/resource-policy: keep
  #     labels:
  #       istio-injection: enabled
  peer-authn-strict:
    apiVersion: security.istio.io/v1beta1
    kind: PeerAuthentication
    metadata:
      name: default
    spec:
      mtls:
        mode: STRICT
